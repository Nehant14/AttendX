# Copy to .env.local (git-ignored) to use.

# Set to true to run the app against built-in mock data (no backend needed)
EXPO_PUBLIC_USE_MOCK=false

# OPTIONAL: pre-fill the backend address the app starts with.
# Normally leave this unset:
#   - while running `npx expo start`, the app auto-detects your PC's LAN IP
#   - in an installed APK, type the address once in Settings (it is remembered)
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.23:8000
# EXPO_PUBLIC_API_URL=
