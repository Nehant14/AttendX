# Copy to backend/.env and adjust as needed for local dev.

APP_NAME=Face Attendance System
ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://attendance:attendance@localhost:5432/attendance

SECRET_KEY=change-me-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Set to "true" once you have Redis + a Celery worker running (docker-compose up).
# Leave "false" for quick local dev without Celery — sessions process
# synchronously inline instead.
USE_CELERY=false

STORAGE_ROOT=./storage
SESSION_PHOTO_DIR=./storage/sessions
ENROLLMENT_PHOTO_DIR=./storage/enrollment
CROP_DIR=./storage/crops
MAX_UPLOAD_MB=15

HIGH_MATCH_THRESHOLD=0.65
LOW_MATCH_THRESHOLD=0.45
MIN_FACE_SIZE_PX=40
MIN_BLUR_SCORE=100.0
DET_SIZE=640
PRELOAD_MODELS=false
MODEL_PACK=buffalo_l
MODEL_VERSION=buffalo_l-v1

ENABLE_TILED_DETECTION=true
TILE_SIZE=1280
TILE_OVERLAP=0.2
NMS_IOU_THRESHOLD=0.4

CORS_ORIGINS=["*"]
